<Window x:Class="Cco.Windows.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cascade Control Overlay — Windows Split-Plane Client"
        Height="700" Width="980"
        MinHeight="600" MinWidth="820"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimary}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Cascade Control Overlay (CCO)" FontSize="20" FontWeight="Bold" />
                    <TextBlock x:Name="HeaderSubtitle" Text="Rust cco-ffi + Official Signed Wintun 0.14.1 · Open-Source MIT/Apache-2.0"
                               Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock x:Name="InvariantBadge" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Text="DIRECT WG HANDSHAKE TX = 0" FontFamily="Consolas" FontWeight="Bold"
                           Foreground="#34D399" />
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Background="{StaticResource BgBrush}" BorderBrush="{StaticResource CardBorderBrush}">
            <TabItem Header="Tunnel">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Tunnel Lifecycle" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
                                <TextBlock x:Name="TunnelStateText" Text="DISCONNECTED" FontSize="14" FontWeight="Bold" Foreground="#94A3B8" />
                                <TextBlock x:Name="TunnelErrorText" Text="" Foreground="#F87171" Margin="0,4,0,8" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="ConnectButton" Content="Connect Split VPN (Wintun)" Padding="16,8"
                                            Background="#2DD4BF" Foreground="#06201E" FontWeight="Bold" Click="ConnectButton_Click" />
                                    <Button x:Name="RekeyButton" Content="Initiate MCC Handshake" Padding="14,8" Margin="10,0,0,0"
                                            IsEnabled="False" Click="RekeyButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Ed25519 Trust Registry v2 Profile" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
                                <TextBlock x:Name="TrustStatusText" Text="No profile loaded. Generate an RFC 5737 demo profile or load a signed JSON file."
                                           Foreground="{StaticResource TextMuted}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Generate RFC 5737 Demo Profile" Padding="12,6" Click="GenerateDemo_Click" />
                                    <Button Content="Import Profile JSON..." Padding="12,6" Margin="10,0,0,0" Click="ImportProfile_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="14">
                            <StackPanel>
                                <TextBlock Text="MCC Control-Plane Settings" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <StackPanel Margin="0,0,20,8">
                                        <TextBlock Text="Selection Mode" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                        <ComboBox x:Name="MccModeCombo" Width="150" SelectedIndex="2">
                                            <ComboBoxItem Content="first" />
                                            <ComboBoxItem Content="window" />
                                            <ComboBoxItem Content="adaptive" />
                                            <ComboBoxItem Content="wait-all" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,20,8">
                                        <TextBlock Text="X1 Fanout" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                        <TextBox x:Name="X1FanoutBox" Width="80" Text="2" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,20,8">
                                        <TextBlock Text="X2 Fanout" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                        <TextBox x:Name="X2FanoutBox" Width="80" Text="2" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,20,8">
                                        <TextBlock Text="TUN IPv4 (RFC 5737)" Foreground="{StaticResource TextMuted}" FontSize="12" />
                                        <TextBox x:Name="TunIpBox" Width="140" Text="198.51.100.10" />
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Telemetry &amp; Proof">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <TextBlock x:Name="TelemetrySummaryText" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"
                                   Text="Waiting for tunnel session..." />
                    </Border>
                    <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="10">
                        <ListBox x:Name="EventsList" Background="Transparent" Foreground="{StaticResource TextPrimary}"
                                 FontFamily="Consolas" BorderThickness="0" />
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Research Analytics (Chapter 3)">
                <StackPanel Margin="12">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="n =" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="AnalyticsN" Width="60" Text="10" Margin="0,0,16,0" />
                            <TextBlock Text="m =" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="AnalyticsM" Width="60" Text="2" Margin="0,0,16,0" />
                            <TextBlock Text="j =" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="AnalyticsJ" Width="60" Text="3" Margin="0,0,16,0" />
                            <Button Content="Compute Exact + Rayon Monte Carlo" Padding="14,6" Click="ComputeAnalytics_Click" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="14">
                        <TextBlock x:Name="AnalyticsOutputText" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"
                                   Text="Press Compute to evaluate I2P / F1 / F3 / F4 models via Rust cco-analytics." />
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
